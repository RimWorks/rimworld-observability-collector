<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>RimObs.Patches.Harmony</AssemblyName>
        <RootNamespace>RimWorks.RimObs.Patches.Harmony</RootNamespace>
        <OutDir>$(MSBuildProjectDirectory)\..\..\Harmony\Assemblies\</OutDir>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <!-- TODO(backends): drop when RimObs.Library stops compiling MethodTransplanter.cs too. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <!-- RimObs.Library copies RimObs.Wire.dll local; without this it lands here too. -->
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
        <ProjectReference>
            <Private>False</Private>
        </ProjectReference>
        <PackageReference>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.*" ExcludeAssets="runtime" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\MethodTransplanter.cs" Link="MethodTransplanter.cs"/>
        <!-- private=false: RimObs.dll ships once, in the root Assemblies folder. a second copy
             here would load the same types twice. -->
        <ProjectReference Include="..\..\RimObs.Library\RimObs.Library.csproj" Private="false"/>
    </ItemGroup>
</Project>

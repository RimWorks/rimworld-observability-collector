<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>RimWorks.RimObs.Tests</RootNamespace>
        <AssemblyName>RimObs.Library.Tests</AssemblyName>
        <!--
          This project compiles the net48 library sources under net10, so the modern
          analyzers offer APIs the library cannot use:
            CA1510  ArgumentNullException.ThrowIfNull            (net6+)
            CA1512  ArgumentOutOfRangeException.ThrowIfLessThan  (net8+)
            CA2249  string.Contains(string, StringComparison)    (netstandard2.1+)
            CA1866  string.EndsWith(char)                        (netcore2.0+)
          The rest fire on reflection and Harmony fixtures, where the shape is the point:
            CA1822      making a probe target static changes the signature the resolver sees
            CA2211      Targets.Counter is written by transplanted IL
            CA1507      the literal names the API's parameter, not the local
            SYSLIB1054  the fixture exists to test a real DllImport extern
        -->
        <NoWarn>$(NoWarn);CA1510;CA1512;CA2249;CA1866;CA1822;CA2211;CA1507;SYSLIB1054</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\RimObs.Wire\RimObs.Wire.csproj"/>
    </ItemGroup>

    <!--
      Library targets net48 (Unity Mono) while this test project targets net10, so a ProjectReference
      cannot link the two TFMs. We compile the Library sources directly instead. A single recursive glob
      picks up new directories automatically; the Exclude list drops the obj/bin build output and the
      game-coupled files (they reference Verse/RimWorld assemblies that are absent under net10).
    -->
    <ItemGroup>
        <Compile Include="..\..\RimObs.Library\**\*.cs"
                 Exclude="..\..\RimObs.Library\obj\**\*.cs;..\..\RimObs.Library\bin\**\*.cs;..\..\RimObs.Library\Bootstrap\RimObsMod.cs;..\..\RimObs.Library\Settings\SettingsWindow.cs;..\..\RimObs.Library\Settings\RimObsSettings.cs"
                 LinkBase="LinkedSource"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="2.5.302"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
        <PackageReference Include="FluentAssertions" Version="6.12.2"/>
        <PackageReference Include="coverlet.collector" Version="6.0.2"/>
    </ItemGroup>
</Project>

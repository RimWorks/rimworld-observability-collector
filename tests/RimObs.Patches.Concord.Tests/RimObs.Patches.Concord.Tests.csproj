<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- NU1701: compiles net48 library sources under net10, so RimLogging and its
             transitive Krafs.Rimworld.Ref restore as net48. -->
        <NoWarn>$(NoWarn);NU1701</NoWarn>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>RimWorks.RimObs.Tests</RootNamespace>
        <AssemblyName>RimObs.Patches.Concord.Tests</AssemblyName>
        <DefineConstants>$(DefineConstants);RIMOBS_CONCORD</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\RimObs.Wire\RimObs.Wire.csproj"/>
    </ItemGroup>

    <!--
      MethodTransplanter compiles to a different shape per backend (Concord hands the transpiler an
      ITranspilerContext, Harmony an ILGenerator), so the two shapes cannot share one test assembly.
      This project is the Concord half: same Library sources as RimObs.Library.Tests, built with
      RIMOBS_CONCORD, plus the Concord backend.
    -->
    <ItemGroup>
        <Compile Include="..\..\RimObs.Library\**\*.cs"
                 Exclude="..\..\RimObs.Library\obj\**\*.cs;..\..\RimObs.Library\bin\**\*.cs;..\..\RimObs.Library\Bootstrap\RimObsMod.cs;..\..\RimObs.Library\Settings\SettingsWindow.cs;..\..\RimObs.Library\Settings\RimObsSettings.cs"
                 LinkBase="LinkedSource"/>
        <Compile Include="..\..\Source\Shared\MethodTransplanter.cs" Link="LinkedSource\MethodTransplanter.cs"/>
        <Compile Include="..\..\Source\RimObs.Patches.Concord\ConcordBackend.cs" Link="LinkedSource\ConcordBackend.cs"/>
        <Compile Include="..\Shared\RecordingSink.cs" Link="LinkedSource\RecordingSink.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="2.5.302"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
        <PackageReference Include="RimWorks.RimLogging" Version="2.4.*"/>
        <!-- TODO(concord-pin): unpin with Concord.Ref, once EndExceptionBlock placement is a
             documented contract or Concord reaches 1.0. the two must move together. -->
        <PackageReference Include="Concord.Runtime" Version="0.14.2"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
        <PackageReference Include="FluentAssertions" Version="6.12.2"/>
        <PackageReference Include="coverlet.collector" Version="6.0.2"/>
    </ItemGroup>
</Project>

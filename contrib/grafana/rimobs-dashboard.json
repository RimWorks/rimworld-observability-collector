        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Vitals",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Ticks and frames per second, as the game reports them.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "per second",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "rimobs_tps{session_id=~\"$session\"} * on(session_id) group_left(session_name) rimobs_session_info",
          "legendFormat": "tps {{session_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "rimobs_fps{session_id=~\"$session\"} * on(session_id) group_left(session_name) rimobs_session_info",
          "legendFormat": "fps {{session_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Tick and frame rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Frame time. The frame budget is 45.45ms (22 fps, RimWorld's target). Tick percentiles are cumulative, so they live in their own stat panel.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 45.45
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "rimobs_frame_ms_p50{session_id=~\"$session\"} * on(session_id) group_left(session_name) rimobs_session_info",
          "legendFormat": "frame p50 {{session_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "rimobs_frame_ms_p99{session_id=~\"$session\"} * on(session_id) group_left(session_name) rimobs_session_info",
          "legendFormat": "frame p99 {{session_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Frame time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
